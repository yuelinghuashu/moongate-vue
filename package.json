{
  "name": "moongate-vue",
  "version": "1.7.0",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "component-library",
    "design-system",
    "css-variables",
    "dark-mode",
    "lightweight",
    "zero-dependencies",
    "moon-themed",
    "vue-components",
    "ui-framework"
  ],
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./reset.css": "./dist/reset.css",
    "./badge": {
      "types": "./dist/exports/Badge.d.ts",
      "import": "./dist/badge.js",
      "default": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/exports/Button.d.ts",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./card": {
      "types": "./dist/exports/Card.d.ts",
      "import": "./dist/card.js",
      "default": "./dist/card.js"
    },
    "./checkbox": {
      "types": "./dist/exports/Checkbox.d.ts",
      "import": "./dist/checkbox.js",
      "default": "./dist/checkbox.js"
    },
    "./container": {
      "types": "./dist/exports/Container.d.ts",
      "import": "./dist/container.js",
      "default": "./dist/container.js"
    },
    "./divider": {
      "types": "./dist/exports/Divider.d.ts",
      "import": "./dist/divider.js",
      "default": "./dist/divider.js"
    },
    "./drawer": {
      "types": "./dist/exports/Drawer.d.ts",
      "import": "./dist/drawer.js",
      "default": "./dist/drawer.js"
    },
    "./dropdown": {
      "types": "./dist/exports/Dropdown.d.ts",
      "import": "./dist/dropdown.js",
      "default": "./dist/dropdown.js"
    },
    "./footer": {
      "types": "./dist/exports/Footer.d.ts",
      "import": "./dist/footer.js",
      "default": "./dist/footer.js"
    },
    "./form": {
      "types": "./dist/exports/Form.d.ts",
      "import": "./dist/form.js",
      "default": "./dist/form.js"
    },
    "./form-item": {
      "types": "./dist/exports/FormItem.d.ts",
      "import": "./dist/form-item.js",
      "default": "./dist/form-item.js"
    },
    "./header": {
      "types": "./dist/exports/Header.d.ts",
      "import": "./dist/header.js",
      "default": "./dist/header.js"
    },
    "./hero": {
      "types": "./dist/exports/Hero.d.ts",
      "import": "./dist/hero.js",
      "default": "./dist/hero.js"
    },
    "./input": {
      "types": "./dist/exports/Input.d.ts",
      "import": "./dist/input.js",
      "default": "./dist/input.js"
    },
    "./main": {
      "types": "./dist/exports/Main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./message": {
      "types": "./dist/exports/Message.d.ts",
      "import": "./dist/message.js",
      "default": "./dist/message.js"
    },
    "./modal": {
      "types": "./dist/exports/Modal.d.ts",
      "import": "./dist/modal.js",
      "default": "./dist/modal.js"
    },
    "./pagination": {
      "types": "./dist/exports/Pagination.d.ts",
      "import": "./dist/pagination.js",
      "default": "./dist/pagination.js"
    },
    "./popover": {
      "types": "./dist/exports/Popover.d.ts",
      "import": "./dist/popover.js",
      "default": "./dist/popover.js"
    },
    "./radio": {
      "types": "./dist/exports/Radio.d.ts",
      "import": "./dist/radio.js",
      "default": "./dist/radio.js"
    },
    "./select": {
      "types": "./dist/exports/Select.d.ts",
      "import": "./dist/select.js",
      "default": "./dist/select.js"
    },
    "./series-nav": {
      "types": "./dist/exports/SeriesNav.d.ts",
      "import": "./dist/series-nav.js",
      "default": "./dist/series-nav.js"
    },
    "./skeleton": {
      "types": "./dist/exports/Skeleton.d.ts",
      "import": "./dist/skeleton.js",
      "default": "./dist/skeleton.js"
    },
    "./switch": {
      "types": "./dist/exports/Switch.d.ts",
      "import": "./dist/switch.js",
      "default": "./dist/switch.js"
    },
    "./table": {
      "types": "./dist/exports/Table.d.ts",
      "import": "./dist/table.js",
      "default": "./dist/table.js"
    },
    "./tabs": {
      "types": "./dist/exports/Tabs.d.ts",
      "import": "./dist/tabs.js",
      "default": "./dist/tabs.js"
    },
    "./textarea": {
      "types": "./dist/exports/Textarea.d.ts",
      "import": "./dist/textarea.js",
      "default": "./dist/textarea.js"
    },
    "./toast": {
      "types": "./dist/exports/Toast.d.ts",
      "import": "./dist/toast.js",
      "default": "./dist/toast.js"
    },
    "./tooltip": {
      "types": "./dist/exports/Tooltip.d.ts",
      "import": "./dist/tooltip.js",
      "default": "./dist/tooltip.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && vite build && pnpm run build:types && pnpm run clean:dts && pnpm run copy:reset && pnpm run verify:build",
    "copy:reset": "mkdir -p dist && cp src/styles/reset.css dist/reset.css",
    "verify:build": "node scripts/verify-build.ts && node scripts/check-tokens.ts",
    "build:types": "vue-tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationDir ./dist --skipLibCheck",
    "prepublishOnly": "pnpm build && pnpm test",
    "docs:dev": "pnpm run register:components && vitepress dev docs",
    "docs:build": "pnpm run register:components && vitepress build docs",
    "register:components": "vitepress-rc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "eslint . --fix",
    "lint:no-fix": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "docs:preview": "vitepress preview docs",
    "clean:dts": "node scripts/clean-dts.ts",
    "publish": "npm publish --access public"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/server-renderer": "^3.5.35",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.10",
    "vitepress": "^1.6.4",
    "vitepress-theme-demoblock": "^3.1.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.7"
  }
}
